<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vox_color_background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/chatListToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vox_color_surface"
        android:elevation="0dp"
        android:paddingHorizontal="@dimen/vox_spacing_4"
        android:title="@string/chat_list_title"
        android:titleTextColor="@color/vox_color_on_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vox_spacing_16"
        android:layout_marginTop="@dimen/vox_spacing_12"
        android:hint="@string/chat_list_search_hint"
        app:boxBackgroundColor="@color/vox_color_surface"
        app:boxStrokeColor="@color/vox_color_border"
        app:hintTextColor="@color/vox_color_subtle_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatListToolbar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:textColor="@color/vox_color_on_surface"
            android:textColorHint="@color/vox_color_subtle_text" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/chatFoldersTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vox_spacing_8"
        android:layout_marginTop="@dimen/vox_spacing_8"
        android:background="@color/vox_color_background"
        app:tabIndicatorColor="@color/vox_color_primary"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabRippleColor="@color/vox_color_surface"
        app:tabSelectedTextColor="@color/vox_color_on_surface"
        app:tabTextColor="@color/vox_color_subtle_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchInputLayout" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/chatFoldersPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vox_spacing_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatFoldersTabs" />

    <include
        android:id="@+id/loadingState"
        layout="@layout/layout_chat_list_loading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vox_spacing_12"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatFoldersTabs" />

    <include
        android:id="@+id/emptyState"
        layout="@layout/layout_chat_list_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vox_spacing_12"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatFoldersTabs" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/newChatFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/vox_spacing_16"
        android:contentDescription="@string/chat_list_action_new_chat"
        android:src="@android:drawable/ic_input_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/vox_color_on_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>
