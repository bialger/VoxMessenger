<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Vox.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/vox_color_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Vox.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/vox_color_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Vox.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/vox_color_on_surface</item>
    </style>

    <style name="TextAppearance.Vox.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/vox_color_subtle_text</item>
    </style>

    <style name="TextAppearance.Vox.ButtonLabel" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Vox.TopBar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/vox_color_surface</item>
        <item name="android:elevation">0dp</item>
        <item name="titleMarginTop">@dimen/vox_spacing_4</item>
        <item name="titleMarginBottom">@dimen/vox_spacing_4</item>
        <item name="titleTextAppearance">@style/TextAppearance.Vox.ScreenTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Vox.Caption</item>
    </style>

    <style name="Widget.Vox.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Vox.ButtonLabel</item>
    </style>

    <style name="Widget.Vox.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/vox_color_surface</item>
        <item name="boxStrokeColor">@color/vox_color_border</item>
        <item name="hintTextColor">@color/vox_color_subtle_text</item>
    </style>

    <style name="Widget.Vox.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/vox_color_on_surface</item>
        <item name="android:textColorHint">@color/vox_color_subtle_text</item>
    </style>

    <style name="Widget.Vox.UnreadBadge" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_unread_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">@dimen/vox_unread_badge_min_size</item>
        <item name="android:minHeight">@dimen/vox_unread_badge_min_size</item>
        <item name="android:paddingStart">@dimen/vox_spacing_8</item>
        <item name="android:paddingEnd">@dimen/vox_spacing_8</item>
        <item name="android:textAppearance">@style/TextAppearance.Vox.Caption</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Vox.SecurityBadge" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_chat_indicator</item>
        <item name="android:paddingStart">@dimen/vox_spacing_8</item>
        <item name="android:paddingEnd">@dimen/vox_spacing_8</item>
        <item name="android:paddingTop">@dimen/vox_spacing_4</item>
        <item name="android:paddingBottom">@dimen/vox_spacing_4</item>
        <item name="android:textAppearance">@style/TextAppearance.Vox.Caption</item>
        <item name="android:textColor">@color/vox_color_secure_accent</item>
    </style>
</resources>
