<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.VoxMessenger" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/vox_color_primary</item>
        <item name="colorPrimaryVariant">@color/vox_color_primary_variant</item>
        <item name="colorOnPrimary">@color/vox_color_on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/vox_color_secondary</item>
        <item name="colorSecondaryVariant">@color/vox_color_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/vox_color_background</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/vox_color_surface</item>
    </style>
</resources>
